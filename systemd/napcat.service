[Unit]
Description=NapCat QQ + OneBot 11 (WS 127.0.0.1:3001)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/Napcat/opt/QQ
ExecStart=/usr/bin/xvfb-run -a ./qq --no-sandbox --disable-dev-shm-usage --disable-gpu -q 2836148023
Restart=always
RestartSec=10
KillMode=mixed
StandardOutput=append:/home/ubuntu/napcat-setup/napcat.log
StandardError=append:/home/ubuntu/napcat-setup/napcat.log

[Install]
WantedBy=default.target
